PORT=5544

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Option 1: direct Supabase Postgres connection
DATABASE_URL=

# Option 2: derive Supabase Postgres connection from these values
SUB_URL=
SUB_PASS=
SUPABASE_DB_USER=postgres
SUPABASE_DB_NAME=postgres
DB_SCHEMA=app

RESEND_API_KEY=
EMAIL_FROM=no-reply@txzy.net

SESSION_SECRET=

APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Starting balance for newly created users
STARTER_DUST_BALANCE=500

# Economy
DUST_COST_FORGE=100
DUST_COST_REPAIR=60
DUST_COST_PVE_ENTRY=40
DUST_COST_PVP_ENTRY=30
DUST_COST_PVP_REVIVE=200
PVP_STAKE_DUST=30
PVP_MATCH_TOLERANCE_PCT=5
PVP_QUEUE_TTL_MINUTES=10
