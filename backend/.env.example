PORT=5544

# Preferred LLM provider (OpenAI-compatible). Used first when set.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Fallback LLM provider (also OpenAI-compatible).
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.6

# Option 1: direct Supabase Postgres connection
DATABASE_URL=

# Option 2: derive Supabase Postgres connection from these values
SUB_URL=
SUB_PASS=
SUPABASE_DB_USER=postgres
SUPABASE_DB_NAME=postgres
DB_SCHEMA=app

RESEND_API_KEY=
EMAIL_FROM=no-reply@txzy.net

SESSION_SECRET=

APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# One-time starting balance for new wallets; effective minimum is 4 * DUST_COST_FORGE.
# Existing wallets are never refilled on login.
STARTER_DUST_BALANCE=500

# Economy
DUST_COST_FORGE=100
DUST_COST_REPAIR=60
DUST_COST_PVE_ENTRY=40
DUST_COST_PVP_ENTRY=30
DUST_COST_PVP_REVIVE=200
PVP_STAKE_DUST=30
PVP_MATCH_TOLERANCE_PCT=5
PVP_QUEUE_TTL_MINUTES=10
PVP_BATTLE_SESSION_WAIT_SECONDS=5
